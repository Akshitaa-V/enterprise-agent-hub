# Model: "scripted" (offline, deterministic), "openai" or "anthropic"
HUB_LLM_PROVIDER=scripted
# Required for openai / anthropic, e.g. the model name from your provider's console
HUB_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing (cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Guards
HUB_MAX_HOPS=6
HUB_MAX_TOOL_CALLS=4
